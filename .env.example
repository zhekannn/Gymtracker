# Generate independent secrets with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
TRUST_PROXY_HOPS=0
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=gymtracker
DB_SSL=false
DB_SYNCHRONIZE=false
# Optional PEM CA certificate, with literal \n between lines, for a cloud PostgreSQL server.
DB_SSL_CA=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
GEMINI_API_KEY=
